{
  "title": "《親密關係》思維導圖",
  "subtitle": "親密關係的四個階段",
  "nodes": [
    {
      "type": "chapter",
      "label": "一、",
      "text": "親密關係的四個階段",
      "children": [
        {
          "type": "section",
          "label": "❶",
          "text": "月暈",
          "children": [
            {
              "type": "topic",
              "label": null,
              "text": "感情、浪漫，對愛的需求導致的亢奮",
              "children": [
                {
                  "type": "detail",
                  "label": null,
                  "text": "幼時歸屬感缺失，重要性未滿足",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "為了獲得快樂、認同、讚許等，尋找伴侶，並按照自己的期願選擇伴侶",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "若個人需求無法滿足則會產生依賴、埋怨等情緒",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "快樂應當向內尋求，若真愛婚姻，你將無所求",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "type": "section",
          "label": "❷",
          "text": "幻滅",
          "children": [
            {
              "type": "topic",
              "label": null,
              "text": "權力鬥爭、控制、舊痛浮現",
              "children": [
                {
                  "type": "detail",
                  "label": null,
                  "text": "偏差行為1.刻意表現",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "想要引起伴侶的注意",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "偏差行為2.權力鬥爭",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "實質：用爭吵麻痺自己，逃避幼時創傷",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "試圖控制對方的行為，藉以遠離舊痛",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "與對方立場相反",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "站在「對的」一方，虛張聲勢",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "分散雙方注意力",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "偏差行為3.報復",
                  "children": []
                }
              ]
            },
            {
              "type": "topic",
              "label": null,
              "text": "溝通、原諒、決心對自己負責",
              "children": [
                {
                  "type": "detail",
                  "label": null,
                  "text": "有效溝通，審視自己痛苦的根源",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "明確自己真正想要的",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "了解事實，避免誤會",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "承認自己的內心",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "其實你的負面情緒一直存在",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "是什麼觸發了這些負面情緒",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "正面回應這些情緒",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "坦然面對自己的無力感",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "充滿愛意",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "type": "section",
          "label": "❸",
          "text": "內省",
          "children": [
            {
              "type": "topic",
              "label": null,
              "text": "懺悔、排斥伴侶或被排斥",
              "children": [
                {
                  "type": "detail",
                  "label": null,
                  "text": "偏差行為4.自我放逐",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "由沮喪感導致",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "親密關係成了當事人受害者-迫害者-拯救者的身份轉換",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "面對兩難境地",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "真心地問自己真正想要的",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "刻板沿襲幼時家庭習慣",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "突破家庭的影響",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "慣性模式",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "改變心志，杜絕依附或盲從",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "對方做的事都是自己厭惡的",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "接受自己的黑暗面",
                  "children": []
                }
              ]
            },
            {
              "type": "topic",
              "label": null,
              "text": "性障礙",
              "children": [
                {
                  "type": "detail",
                  "label": null,
                  "text": "與伴侶開誠布公心靈溝通",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "與伴侶相互較勁",
                  "children": []
                },
                {
                  "type": "detail",
                  "label": null,
                  "text": "有愛便沒有競爭關係",
                  "children": []
                }
              ]
            },
            {
              "type": "topic",
              "label": null,
              "text": "目標",
              "children": [
                {
                  "type": "detail",
                  "label": null,
                  "text": "用愛來面對自己內在的事物",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "type": "section",
          "label": "❹",
          "text": "啟示",
          "children": [
            {
              "type": "detail",
              "label": null,
              "text": "放下一己之私，擁抱愛，感受愛",
              "children": []
            }
          ]
        }
      ]
    }
  ]
}
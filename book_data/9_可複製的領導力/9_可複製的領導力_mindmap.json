              "type": "detail",
              "label": null,
              "text": "公開象限最大",
              "children": []
            },
            {
              "type": "detail",
              "label": null,
              "text": "隱私象限：自己知道，他人不知道",
              "children": []
            },
            {
              "type": "detail",
              "label": null,
